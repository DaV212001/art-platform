# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://artplatform:artplatform_secret@localhost:5432/artplatform
DB_HOST=localhost
DB_PORT=5432
DB_USER=artplatform
DB_PASSWORD=artplatform_secret
DB_NAME=artplatform

# ─── API ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=replace_me_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary (Image Storage — free tier) ──────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email — Brevo SMTP (free: 300 emails/day) ───────────────
# For local development, leave EMAIL_PROVIDER=ethereal to use
# Nodemailer Ethereal (no account needed, catches emails locally)
EMAIL_PROVIDER=ethereal
# For production, set EMAIL_PROVIDER=brevo and fill below:
# EMAIL_PROVIDER=brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login@email.com
BREVO_SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM=noreply@artplatform.com
EMAIL_FROM_NAME=Art Platform

# ─── App ─────────────────────────────────────────────────────
APP_NAME=Deliberate Practice Art Platform
APP_URL=http://localhost:3001
